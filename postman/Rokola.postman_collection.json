                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
                  "    pm.expect(pm.response.json().title).to.eql('Establecimiento no encontrado');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/establecimientos/999999999/configuracion",
              "host": ["{{baseUrl}}"],
              "path": ["api", "establecimientos", "999999999", "configuracion"]
            }
          },
          "response": []
        },
        {
          "name": "Codigos QR de un establecimiento",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const codigos = pm.response.json();",
                  "const camposEsperados = ['id', 'fechaCreacion', 'fechaRevocacion', 'activo'];",
                  "",
                  "pm.test('Responde 200 OK con una lista', () => {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(codigos).to.be.an('array').that.is.not.empty;",
                  "});",
                  "",
                  "pm.test('Cada codigo tiene exactamente los campos del contrato', () => {",
                  "    codigos.forEach(c => pm.expect(Object.keys(c)).to.have.members(camposEsperados));",
                  "});",
                  "",
                  "pm.test('SEGURIDAD: no expone la huella del token', () => {",
                  "    pm.expect(pm.response.text()).to.not.include('token');",
                  "    pm.expect(pm.response.text(), 'la respuesta contiene un hash SHA-256').to.not.match(/[0-9a-f]{64}/i);",
                  "});",
                  "",
                  "pm.test('Viene del mas reciente al mas antiguo', () => {",
                  "    const fechas = codigos.map(c => Date.parse(c.fechaCreacion));",
                  "    pm.expect(fechas).to.eql([...fechas].sort((a, b) => b - a));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/establecimientos/{{idEstablecimiento}}/codigos-qr",
              "host": ["{{baseUrl}}"],
              "path": ["api", "establecimientos", "{{idEstablecimiento}}", "codigos-qr"]
            }
          },
          "response": []
        },
        {
          "name": "Codigos QR de un establecimiento inexistente",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 404 Establecimiento no encontrado', () => {",
                  "    pm.response.to.have.status(404);",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
                  "    pm.expect(pm.response.json().title).to.eql('Establecimiento no encontrado');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/establecimientos/999999999/codigos-qr",
              "host": ["{{baseUrl}}"],
              "path": ["api", "establecimientos", "999999999", "codigos-qr"]
            }
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
